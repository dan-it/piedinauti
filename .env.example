# Variables read by Docker Compose (not by Laravel; Laravel uses src/.env).

# Which compose files to load. Development by default; on the server use:
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
COMPOSE_PROJECT_NAME=piedinauti

# Host user and group ids, so files created in containers belong to you.
# scripts/bootstrap.sh fills these in automatically.
HOST_UID=1000
HOST_GID=1000

# Public ports. Development uses unprivileged ports; use 80/443 in production.
HTTP_PORT=8090
HTTPS_PORT=8443

# ":80" = plain HTTP (development). In production set the domain name,
# e.g. app.example.it, and Caddy will handle HTTPS automatically.
SITE_ADDRESS=:80

# Database credentials, shared by the db service and Laravel.
DB_DATABASE=piedinauti
DB_USERNAME=piedinauti
DB_PASSWORD=change-me
